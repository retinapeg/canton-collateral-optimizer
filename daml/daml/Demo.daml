module Demo where

import Collateral
import qualified CollateralAllocation as Bilateral
import DA.Optional (isNone)
import Daml.Script

data DemoParties = DemoParties with
  bankA : Party
  bankB : Party
  allocator : Party
  ccp : Party

allocateDemoParties : Script DemoParties
allocateDemoParties = do
  bankA <- allocatePartyByHint (PartyIdHint "BankA")
  bankB <- allocatePartyByHint (PartyIdHint "BankB")
  allocator <- allocatePartyByHint (PartyIdHint "Allocator")
  ccp <- allocatePartyByHint (PartyIdHint "CCP")
  pure DemoParties with bankA; bankB; allocator; ccp

createOfferA : DemoParties -> Script (ContractId CollateralOffer)
createOfferA parties = submit parties.bankA do
  createCmd CollateralOffer with
    owner = parties.bankA
    allocator = parties.allocator
    assetId = "A-GILT-2030"
    assetClass = "GOVERNMENT_BOND"
    marketValue = 100.0
    haircut = 0.02
    opportunityCost = 0.5
    availableQuantity = 10.0
    location = "Custodian-A"

createOfferB : DemoParties -> Script (ContractId CollateralOffer)
createOfferB parties = submit parties.bankB do
  createCmd CollateralOffer with
    owner = parties.bankB
    allocator = parties.allocator
    assetId = "B-CORP-2029"
    assetClass = "CORPORATE_BOND"
    marketValue = 100.0
    haircut = 0.2
    opportunityCost = 0.4
    availableQuantity = 10.0
    location = "Repo-Venue-B"

createRequirementA : DemoParties -> Script (ContractId CollateralRequirement)
createRequirementA parties = submit parties.ccp do
  createCmd CollateralRequirement with
    obligor = parties.bankA
    beneficiary = parties.ccp
    allocator = parties.allocator
    requirementId = "REQ-BANK-A-CCP"
    requiredEffectiveValue = 500.0
    eligibleAssetClasses = ["GOVERNMENT_BOND", "CASH"]

createRequirementB : DemoParties -> Script (ContractId CollateralRequirement)
createRequirementB parties = submit parties.ccp do
  createCmd CollateralRequirement with
    obligor = parties.bankB
    beneficiary = parties.ccp
    allocator = parties.allocator
    requirementId = "REQ-BANK-B-CCP"
    requiredEffectiveValue = 400.0
    eligibleAssetClasses = ["GOVERNMENT_BOND", "CORPORATE_BOND"]

-- A convenient live-ledger seeding script.  The Python backend can then query
-- the authorised Allocator view and create proposals from optimiser output.
setup : Script ()
setup = script do
  parties <- allocateDemoParties
  _ <- createOfferA parties
  _ <- createOfferB parties
  _ <- createRequirementA parties
  _ <- createRequirementB parties
  pure ()

-- The visible bilateral smart-contract demo. Bank A creates a real proposal,
-- Bank B observes and accepts it, and the resulting allocation remains active.
privacyAndAcceptance : Script ()
privacyAndAcceptance = script do
  debugRaw "=================================================="
  debugRaw "CANTON COLLATERAL ALLOCATION"
  debugRaw "=================================================="

  bankA <- allocatePartyByHint (PartyIdHint "BankA")
  bankB <- allocatePartyByHint (PartyIdHint "BankB")

  debugRaw ""
  debugRaw "BANK A"
  debugRaw "Asset available: UK_GILT_2035"
  debugRaw "Proposed allocation: 30"

  proposalCid <- submit bankA do
    createCmd Bilateral.AllocationProposal with
      source = bankA
      recipient = bankB
      asset = "UK_GILT_2035"
      quantity = 30.0
      allocationReference = "optimizer-allocation-001"

  debugRaw ""
  debugRaw "SMART CONTRACT CREATED"
  debugRaw "BankA -> BankB"
  debugRaw "Asset: UK_GILT_2035"
  debugRaw "Quantity: 30"
  debugRaw "Reference: optimizer-allocation-001"

  Some proposalForBankB <- queryContractId bankB proposalCid
  assert (proposalForBankB.source == bankA)
  assert (proposalForBankB.recipient == bankB)
  assert (proposalForBankB.asset == "UK_GILT_2035")
  assert (proposalForBankB.quantity == 30.0)
  assert
    (proposalForBankB.allocationReference == "optimizer-allocation-001")

  debugRaw ""
  debugRaw "BANK B"
  debugRaw "Proposal visible: YES"

  -- Bank A is the proposal signatory, but only Bank B controls Accept.
  submitMustFail bankA do
    exerciseCmd proposalCid Bilateral.Accept

  debugRaw "Accepting allocation..."
  allocationCid <- submit bankB do
    exerciseCmd proposalCid Bilateral.Accept

  debugRaw ""
  debugRaw "SMART CONTRACT ACCEPTED"

  proposalAfterAcceptance <- queryContractId bankB proposalCid
  assert (isNone proposalAfterAcceptance)

  Some allocationForBankB <- queryContractId bankB allocationCid
  Some allocationForBankA <- queryContractId bankA allocationCid
  assert (allocationForBankB == allocationForBankA)
  assert (allocationForBankB.source == bankA)
  assert (allocationForBankB.recipient == bankB)
  assert (allocationForBankB.asset == "UK_GILT_2035")
  assert (allocationForBankB.quantity == 30.0)
  assert
    (allocationForBankB.allocationReference == "optimizer-allocation-001")

  debugRaw ""
  debugRaw "BANK B RECEIVED ALLOCATION"
  debugRaw "30 UK_GILT_2035"
  debugRaw ""
  debugRaw "LEDGER RESULT"
  debugRaw "[PASS] Proposal created by Bank A"
  debugRaw "[PASS] Bank B observed proposal"
  debugRaw "[PASS] Bank B accepted"
  debugRaw "[PASS] Accepted allocation contract active"
  debugRaw "[PASS] Bank A could not accept on Bank B's behalf"
  debugRaw ""
  debugRaw "=================================================="

-- The original optimiser/Allocator/CCP proof is retained as a separate test so
-- its disclosure, controller, residual-offer and stale-state coverage remains.
optimizerPrivacyAndAcceptance : Script ()
optimizerPrivacyAndAcceptance = script do
  parties <- allocateDemoParties
  offerA <- createOfferA parties
  offerB <- createOfferB parties
  requirementA <- createRequirementA parties
  requirementB <- createRequirementB parties

  proposalA <- submit parties.allocator do
    createCmd ReallocationProposal with
      allocator = parties.allocator
      owner = parties.bankA
      offerCid = offerA
      requirementCid = requirementA
      assetId = "A-GILT-2030"
      requirementId = "REQ-BANK-A-CCP"
      quantity = 5.1020408164

  _proposalB <- submit parties.allocator do
    createCmd ReallocationProposal with
      allocator = parties.allocator
      owner = parties.bankB
      offerCid = offerB
      requirementCid = requirementB
      assetId = "B-CORP-2029"
      requirementId = "REQ-BANK-B-CCP"
      quantity = 1.0

  allocatorOffers <- query @CollateralOffer parties.allocator
  bankAOffers <- query @CollateralOffer parties.bankA
  bankBOffers <- query @CollateralOffer parties.bankB
  assert (length allocatorOffers == 2)
  assert (length bankAOffers == 1)
  assert (length bankBOffers == 1)

  bankACannotSeeB <- queryContractId parties.bankA offerB
  bankBCannotSeeA <- queryContractId parties.bankB offerA
  assert (isNone bankACannotSeeB)
  assert (isNone bankBCannotSeeA)

  bankAProposals <- query @ReallocationProposal parties.bankA
  bankBProposals <- query @ReallocationProposal parties.bankB
  assert (length bankAProposals == 1)
  assert (length bankBProposals == 1)

  submitMustFail parties.allocator do
    exerciseCmd proposalA Accept
  submitMustFail parties.bankB do
    exerciseCmd proposalA Accept

  -- Neither party can bypass the proposal flow and mint a final allocation
  -- unilaterally.  Accept combines the allocator's proposal authority with the
  -- owner's choice authority to create the bilateral contract.
  submitMustFail parties.bankA do
    createCmd CollateralAllocation with
      allocator = parties.allocator
      owner = parties.bankA
      beneficiary = parties.ccp
      assetId = "A-GILT-2030"
      requirementId = "REQ-BANK-A-CCP"
      quantity = 5.1020408164
      effectiveValue = 500.0000000072
      location = "Custodian-A"

  submitMustFail parties.allocator do
    createCmd CollateralAllocation with
      allocator = parties.allocator
      owner = parties.bankA
      beneficiary = parties.ccp
      assetId = "A-GILT-2030"
      requirementId = "REQ-BANK-A-CCP"
      quantity = 5.1020408164
      effectiveValue = 500.0000000072
      location = "Custodian-A"

  staleProposal <- submit parties.allocator do
    createCmd ReallocationProposal with
      allocator = parties.allocator
      owner = parties.bankA
      offerCid = offerA
      requirementCid = requirementA
      assetId = "A-GILT-2030"
      requirementId = "REQ-BANK-A-CCP"
      quantity = 1.0

  accepted <- submit parties.bankA do
    exerciseCmd proposalA Accept

  oldOffer <- queryContractId parties.bankA offerA
  oldProposal <- queryContractId parties.bankA proposalA
  assert (isNone oldOffer)
  assert (isNone oldProposal)

  let Some remainingOfferCid = accepted.remainingOfferCid
  Some remainingOffer <- queryContractId parties.bankA remainingOfferCid
  assert (remainingOffer.availableQuantity == 4.8979591836)

  Some allocationForBankA <-
    queryContractId parties.bankA accepted.allocationCid
  Some allocationForAllocator <-
    queryContractId parties.allocator accepted.allocationCid
  Some allocationForCcp <-
    queryContractId parties.ccp accepted.allocationCid
  allocationForBankB <-
    queryContractId parties.bankB accepted.allocationCid
  assert (allocationForBankA.quantity == 5.1020408164)
  assert (allocationForAllocator == allocationForBankA)
  assert (allocationForCcp == allocationForBankA)
  assert (isNone allocationForBankB)

  submitMustFail parties.bankA do
    exerciseCmd staleProposal Accept
