-- Run from the exercise directory with: dpm test
module MandateTest where

import DA.Time (addRelTime, hours)
import Daml.Script
import Mandate


allocateWalletParties : () -> Script (Party, Party, Party, Party)
allocateWalletParties () = do
  owner <- allocateParty "WalletOwner"
  agent <- allocateParty "WalletAgent"
  merchant <- allocateParty "AllowedMerchant"
  otherMerchant <- allocateParty "OtherMerchant"
  pure (owner, agent, merchant, otherMerchant)


createAcceptedMandate
  : Party
  -> Party
  -> [Party]
  -> Decimal
  -> Time
  -> Text
  -> Script (ContractId Mandate)
createAcceptedMandate owner agent allowedCounterparties cap expiresAt mandateReference = do
  proposalCid <- submit owner do
    createCmd MandateProposal with
      owner
      agent
      cap
      expiresAt
      allowedCounterparties
      mandateReference

  submit agent do exerciseCmd proposalCid Accept


submitCharge
  : Party
  -> ContractId Mandate
  -> Party
  -> Decimal
  -> Text
  -> Script ChargeResult
submitCharge agent mandateCid counterparty amount memo =
  submit agent do
    exerciseCmd mandateCid Charge with counterparty; amount; memo


testAllowListedChargeSucceeds : Script ()
testAllowListedChargeSucceeds = script do
  (owner, agent, merchant, _) <- allocateWalletParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  mandateCid <- createAcceptedMandate
    owner agent [merchant] 100.0 expiresAt "MANDATE-ALLOW-LISTED"

  result <- submitCharge agent mandateCid merchant 25.0 "Approved supplier invoice"

  Some updatedMandate <- queryContractId owner result.mandateCid
  Some audit <- queryContractId owner result.auditCid
  assert (updatedMandate.spent == 25.0)
  assert (audit.counterparty == merchant)
  assert (audit.amount == 25.0)
  pure ()


testCumulativeSpendingAcrossTwoCharges : Script ()
testCumulativeSpendingAcrossTwoCharges = script do
  (owner, agent, merchant, _) <- allocateWalletParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  mandateCid <- createAcceptedMandate
    owner agent [merchant] 100.0 expiresAt "MANDATE-CUMULATIVE"

  first <- submitCharge agent mandateCid merchant 30.0 "First approved charge"
  second <- submitCharge agent first.mandateCid merchant 50.0 "Second approved charge"

  Some updatedMandate <- queryContractId owner second.mandateCid
  Some firstAudit <- queryContractId owner first.auditCid
  Some secondAudit <- queryContractId owner second.auditCid
  assert (updatedMandate.spent == 80.0)
  assert (firstAudit.previousSpent == 0.0)
  assert (firstAudit.newSpent == 30.0)
  assert (secondAudit.previousSpent == 30.0)
  assert (secondAudit.newSpent == 80.0)
  pure ()


testChargeOverCapFails : Script ()
testChargeOverCapFails = script do
  (owner, agent, merchant, _) <- allocateWalletParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  mandateCid <- createAcceptedMandate
    owner agent [merchant] 100.0 expiresAt "MANDATE-CAP-FAILURE"
  first <- submitCharge agent mandateCid merchant 80.0 "Initial approved charge"

  submitMustFail agent do
    exerciseCmd first.mandateCid Charge with
      counterparty = merchant
      amount = 21.0
      memo = "Must exceed cumulative cap"

  Some unchangedMandate <- queryContractId owner first.mandateCid
  audits <- query @ChargeRecord owner
  assert (unchangedMandate.spent == 80.0)
  assert (length audits == 1)
  pure ()


testNonAllowListedCounterpartyFails : Script ()
testNonAllowListedCounterpartyFails = script do
  (owner, agent, merchant, otherMerchant) <- allocateWalletParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  mandateCid <- createAcceptedMandate
    owner agent [merchant] 100.0 expiresAt "MANDATE-COUNTERPARTY-FAILURE"

  submitMustFail agent do
    exerciseCmd mandateCid Charge with
      counterparty = otherMerchant
      amount = 10.0
      memo = "Unapproved merchant"

  Some unchangedMandate <- queryContractId owner mandateCid
  audits <- query @ChargeRecord owner
  assert (unchangedMandate.spent == 0.0)
  assert (length audits == 0)
  pure ()


