redTeamSettlement07OwnerCannotPretendToBeAgent : Script ()
redTeamSettlement07OwnerCannotPretendToBeAgent = script do
  parties <- allocateParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  let assetId = "DEMO-GBP:RED-SETTLEMENT-07"
  assetCid <- issueAsset parties 100.0 assetId
  mandateCid <- activateMandate
    parties assetCid 100.0 100.0 expiresAt [parties.merchantA]
    "RED-SETTLEMENT-07" assetId
  before <- captureLedger parties
  submitMustFail parties.owner do
    exerciseCmd mandateCid Charge with
      merchant = parties.merchantA
      amount = 1.0
      memo = "owner impersonation"
  after <- captureLedger parties
  assertUnchanged "owner impersonation" before after


-- The merchant receives owner read visibility for this submission so the
-- failure isolates controller authorization, not contract visibility.
redTeamSettlement08MerchantCannotPretendToBeAgent : Script ()
redTeamSettlement08MerchantCannotPretendToBeAgent = script do
  parties <- allocateParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  let assetId = "DEMO-GBP:RED-SETTLEMENT-08"
  assetCid <- issueAsset parties 100.0 assetId
  mandateCid <- activateMandate
    parties assetCid 100.0 100.0 expiresAt [parties.merchantA]
    "RED-SETTLEMENT-08" assetId
  before <- captureLedger parties
  submitMustFail (actAs parties.merchantA <> readAs parties.owner) do
    exerciseCmd mandateCid Charge with
      merchant = parties.merchantA
      amount = 1.0
      memo = "merchant impersonation"
  after <- captureLedger parties
  assertUnchanged "merchant impersonation" before after


redTeamSettlement09ValidAgentAfterExpiryFailsAtomically : Script ()
redTeamSettlement09ValidAgentAfterExpiryFailsAtomically = script do
  parties <- allocateParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 1)
  let assetId = "DEMO-GBP:RED-SETTLEMENT-09"
  assetCid <- issueAsset parties 100.0 assetId
  mandateCid <- activateMandate
    parties assetCid 100.0 100.0 expiresAt [parties.merchantA]
    "RED-SETTLEMENT-09" assetId
  setTime expiresAt
  before <- captureLedger parties
  submitMustFail parties.agent do
    exerciseCmd mandateCid Charge with
      merchant = parties.merchantA
      amount = 1.0
      memo = "post-expiry attack"
  after <- captureLedger parties
  assertUnchanged "post expiry" before after


redTeamSettlement10ValidAgentAfterRevocationFailsAtomically : Script ()
redTeamSettlement10ValidAgentAfterRevocationFailsAtomically = script do
  parties <- allocateParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  let assetId = "DEMO-GBP:RED-SETTLEMENT-10"
  assetCid <- issueAsset parties 100.0 assetId
  mandateCid <- activateMandate
    parties assetCid 100.0 100.0 expiresAt [parties.merchantA]
    "RED-SETTLEMENT-10" assetId
  successful <- charge parties.agent mandateCid parties.merchantA 30.0 "valid before revoke"
  submit parties.owner do exerciseCmd successful.mandateCid Revoke
  before <- captureLedger parties
  submitMustFail parties.agent do
    exerciseCmd successful.mandateCid Charge with
      merchant = parties.merchantA
      amount = 1.0
      memo = "post-revocation attack"
  after <- captureLedger parties
  assert (length after.mandates == 0)
  assert (length after.audits == 1)
  assert (assetTotal after.assets == 100.0)
  assert (holderBalance parties.owner after.assets == 70.0)
  assert (holderBalance parties.merchantA after.assets == 30.0)
  assertUnchanged "post revocation" before after


redTeamSettlement11StaleCidAfterSuccessFailsAtomically : Script ()
redTeamSettlement11StaleCidAfterSuccessFailsAtomically = script do
  parties <- allocateParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  let assetId = "DEMO-GBP:RED-SETTLEMENT-11"
  assetCid <- issueAsset parties 100.0 assetId
  staleCid <- activateMandate
    parties assetCid 100.0 100.0 expiresAt [parties.merchantA]
    "RED-SETTLEMENT-11" assetId
  successful <- charge parties.agent staleCid parties.merchantA 30.0 "valid charge"
  staleBefore <- queryContractId parties.owner staleCid
  before <- captureLedger parties
  submitMustFail parties.agent do
    exerciseCmd staleCid Charge with
      merchant = parties.merchantA
      amount = 1.0
      memo = "stale CID replay"
  staleAfter <- queryContractId parties.owner staleCid
  after <- captureLedger parties
  assertArchived "stale mandate before replay" staleBefore
  assertArchived "stale mandate after replay" staleAfter
  Some successor <- queryContractId parties.owner successful.mandateCid
  assert (successor.spent == 30.0)
  assertUnchanged "stale CID after success" before after


redTeamSettlement12AdjustBelowSpentFailsAtomically : Script ()
redTeamSettlement12AdjustBelowSpentFailsAtomically = script do
  parties <- allocateParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  let assetId = "DEMO-GBP:RED-SETTLEMENT-12"
  assetCid <- issueAsset parties 100.0 assetId
  initialCid <- activateMandate
    parties assetCid 100.0 100.0 expiresAt [parties.merchantA]
    "RED-SETTLEMENT-12" assetId
  successful <- charge parties.agent initialCid parties.merchantA 60.0 "committed spend"
  before <- captureLedger parties
  submitMustFail (actAs [parties.owner, parties.agent]) do
    exerciseCmd successful.mandateCid Adjust with newCap = 59.0
  after <- captureLedger parties
  assertUnchanged "adjust below spent" before after


redTeamSettlement13BilateralAdjustmentRequired : Script ()
redTeamSettlement13BilateralAdjustmentRequired = script do
  parties <- allocateParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  let assetId = "DEMO-GBP:RED-SETTLEMENT-13"
  assetCid <- issueAsset parties 100.0 assetId
  mandateCid <- activateMandate
    parties assetCid 100.0 100.0 expiresAt [parties.merchantA]
    "RED-SETTLEMENT-13" assetId
  initial <- captureLedger parties

  submitMustFail parties.owner do
    exerciseCmd mandateCid Adjust with newCap = 200.0
  afterOwner <- captureLedger parties
  assertUnchanged "owner-only adjust" initial afterOwner

  submitMustFail parties.agent do
    exerciseCmd mandateCid Adjust with newCap = 200.0
  afterAgent <- captureLedger parties
  assertUnchanged "agent-only adjust" initial afterAgent

  adjustedCid <- submit (actAs [parties.owner, parties.agent]) do
    exerciseCmd mandateCid Adjust with newCap = 200.0
  Some adjusted <- queryContractId parties.owner adjustedCid
  oldMandate <- queryContractId parties.owner mandateCid
  afterJoint <- captureLedger parties
  assertArchived "pre-adjust mandate" oldMandate
  assert (adjusted.cap == 200.0)
  assert (adjusted.spent == 0.0)
  assert (assetTotal afterJoint.assets == 100.0)
  assert (length afterJoint.audits == 0)


-- The DemoAsset remains owner-controlled rather than escrowed. If the owner
-- moves the exact bound CID, a later agent Charge safely fails and cannot alter
-- the stale mandate, the replacement owner action, or audit state.
redTeamSettlementOwnerCustodyStaleBindingRollsBack : Script ()
redTeamSettlementOwnerCustodyStaleBindingRollsBack = script do
  parties <- allocateParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  let assetId = "DEMO-GBP:RED-SETTLEMENT-CUSTODY"
  assetCid <- issueAsset parties 100.0 assetId
  mandateCid <- activateMandate
    parties assetCid 100.0 100.0 expiresAt [parties.merchantA]
    "RED-SETTLEMENT-CUSTODY" assetId
  movedCid <- submit parties.owner do
    exerciseCmd assetCid Give with newHolder = parties.owner
  archivedBoundAsset <- queryContractId parties.owner assetCid
  Some movedAsset <- queryContractId parties.owner movedCid
  assertArchived "owner-moved bound asset" archivedBoundAsset
  assert (movedAsset.amount == 100.0)
  before <- captureLedger parties
  submitMustFail parties.agent do
    exerciseCmd mandateCid Charge with
      merchant = parties.merchantA
      amount = 10.0
      memo = "bound asset was moved by owner"
  after <- captureLedger parties
  assert (holderBalance parties.owner after.assets == 100.0)
  assert (holderBalance parties.merchantA after.assets == 0.0)
  assert (length after.audits == 0)
  assertUnchanged "owner custody stale binding" before after
