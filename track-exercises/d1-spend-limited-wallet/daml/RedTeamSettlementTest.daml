redTeamSettlement06DisallowedMerchantFailsAtomically : Script ()
redTeamSettlement06DisallowedMerchantFailsAtomically = script do
  parties <- allocateParties ()
  now <- getTime
  let expiresAt = addRelTime now (hours 24)
  let assetId = "DEMO-GBP:RED-SETTLEMENT-06"
  assetCid <- issueAsset parties 100.0 assetId
  mandateCid <- activateMandate
    parties assetCid 100.0 100.0 expiresAt [parties.merchantA]
    "RED-SETTLEMENT-06" assetId
  before <- captureLedger parties
  submitMustFail parties.agent do
    exerciseCmd mandateCid Charge with
      merchant = parties.merchantB
      amount = 10.0
      memo = "disallowed merchant"
