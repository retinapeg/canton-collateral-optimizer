# Copy this file to .env and replace every bracketed placeholder locally.
# Never commit .env or paste any resolved value into logs or transcripts.
C8_BASE="https://<ledger-api-host>/api/ledger"
C8_IDP="https://<identity-provider-host>"
C8_CLIENT_ID="<client-id>"
C8_CLIENT_SECRET="<client-secret>"
C8_REGISTRY="https://<registry-host>"
