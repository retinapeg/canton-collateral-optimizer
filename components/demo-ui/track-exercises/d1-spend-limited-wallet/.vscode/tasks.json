{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Daml: Build exercise",
      "type": "shell",
      "command": "dpm",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home",
          "PATH": "/Users/leonardaarons-ditson/.dpm/bin:/opt/homebrew/opt/openjdk@17/bin:${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Daml: Test exercise",
      "type": "shell",
      "command": "dpm",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home",
          "PATH": "/Users/leonardaarons-ditson/.dpm/bin:/opt/homebrew/opt/openjdk@17/bin:${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Daml: Debug testMandate",
      "type": "shell",
      "command": "dpm",
      "args": [
        "test",
        "--test-pattern",
        "testMandate",
        "--show-coverage",
        "--transactions-output",
        ".daml/debug-transactions"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home",
          "PATH": "/Users/leonardaarons-ditson/.dpm/bin:/opt/homebrew/opt/openjdk@17/bin:${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Daml: Build and test exercise",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Daml: Build exercise",
        "Daml: Test exercise"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
